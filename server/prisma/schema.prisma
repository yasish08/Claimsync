generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
}

enum ClaimType {
  AUTO
  HEALTH
  PROPERTY
  TRAVEL
  LIFE
  OTHER
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  CLOSED
}

enum ClaimPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationKind {
  SLA_AT_RISK
  SLA_BREACHED
  CLAIM_ASSIGNED
  STATUS_CHANGED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  REASSIGNED
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String
  role         UserRole         @default(AGENT)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignments  ClaimAssignment[]
  history      ClaimHistory[]   @relation("HistoryActor")
  createdAssignments ClaimAssignment[] @relation("AssignmentCreator")
  notifications Notification[]

  @@index([role, isActive])
}

model Claim {
  id               String            @id @default(cuid())
  claimNumber      String            @unique
  claimantName     String
  claimantEmail    String
  policyNumber     String
  type             ClaimType
  description      String            @db.Text
  estimatedAmount  Decimal           @db.Decimal(12, 2)
  urgency          Int               @default(3)
  businessImpact   Int               @default(3)
  priorityScore    Int               @default(0)
  priority         ClaimPriority      @default(MEDIUM)
  status           ClaimStatus       @default(SUBMITTED)
  submittedAt      DateTime          @default(now())
  slaDeadline      DateTime
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assignments      ClaimAssignment[]
  history          ClaimHistory[]
  notifications     Notification[]

  @@index([status, priorityScore(sort: Desc)])
  @@index([slaDeadline, status])
  @@index([type, submittedAt])
  @@index([claimantEmail])
}

model ClaimAssignment {
  id          String           @id @default(cuid())
  claimId     String
  agentId     String
  assignedBy  String?
  status      AssignmentStatus @default(ACTIVE)
  assignedAt  DateTime         @default(now())
  completedAt DateTime?
  claim       Claim            @relation(fields: [claimId], references: [id], onDelete: Cascade)
  agent       User             @relation(fields: [agentId], references: [id])
  assigner    User?            @relation("AssignmentCreator", fields: [assignedBy], references: [id], onDelete: SetNull)
  @@index([agentId, status])
  @@index([claimId, status])
}

model ClaimHistory {
  id         String   @id @default(cuid())
  claimId    String
  actorId    String?
  action     String
  fromStatus ClaimStatus?
  toStatus   ClaimStatus?
  note       String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actor      User?    @relation("HistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([claimId, createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  claimId   String?
  kind      NotificationKind
  title     String
  message   String           @db.Text
  createdAt DateTime         @default(now())
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  claim     Claim?           @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@unique([userId, claimId, kind])
  @@index([userId, readAt, createdAt])
}
